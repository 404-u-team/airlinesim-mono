{
  "name": "airlinesim",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "packageManager": "bun@1.3.1",
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "check": "turbo lint",
    "dev": "bun run generate:openapi && bun run generate:bff-openapi && turbo dev --concurrency=14",
    "dev:fresh": "bun run ports:clear && bun run dev",
    "generate:bff-openapi": "bun bff/src/scripts/generate-openapi.ts",
    "generate:openapi": "bun packages/api-contracts/scripts/generate-openapi.ts",
    "lint": "turbo lint",
    "lint:fix": "turbo run lint:fix --continue=always --force",
    "ports:clear": "bun run scripts/clear-dev-ports.ts",
    "test": "turbo test"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "bff",
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@module-federation/rsbuild-plugin": "^2.3.2",
    "turbo": "^2.9.6"
  }
}
