# Browser-facing origin served by your reverse proxy, without a path.
AIRLINESIM_PUBLIC_URL=https://airlinesim.example.com

# Initial admin account. The BFF uses the same credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_NICKNAME=admin
ADMIN_PASSWORD=

# Generate a different URL-safe password for each database (openssl rand -hex 24).
AUTH_DB_PASSWORD=
AIRLINE_DB_PASSWORD=
FLEET_DB_PASSWORD=
OPERATIONS_DB_PASSWORD=
TICK_DB_PASSWORD=

# Generate once (openssl rand -base64 16 | tr '/+' '_-' | tr -d '=').
KAFKA_CLUSTER_ID=

# Optional overrides. Defaults are defined in compose.yaml.
# For Komodo, set an absolute directory on the Docker host outside the Git checkout.
# JWT_KEYS_DIR=/srv/airlinesim/secrets
# START_REAL_TIME=1777971530
# START_GAME_TIME=1777971530
# TIME_MULTIPLIER=15
# PRODUCE_MISSED_EVENTS=false
# START_FUEL_PRICE=100
# JWT_ACCESS_TOKEN_EXPIRE_TIME=900
# JWT_REFRESH_TOKEN_EXPIRE_TIME=86400
# REQUEST_TIMEOUT_SECONDS=3
# REST_COUNTRIES_API_KEY=
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=
